# 仅模板；复制到服务器 /etc/laoshi/api.env 后填入真实凭据。
# 不要把真实密码写回此文件；使用 URI 百分号编码后的密码。
DATABASE_URL=postgres://laoshi:CHANGE_ME@127.0.0.1:5432/laoshi?sslmode=disable
HTTP_ADDR=127.0.0.1:8787
TOKEN_TTL_DAYS=30
# 同源网页无需 CORS 授权；其他 H5/WebView Origin 按实际 adapter 核对后添加，勿使用 *。
CORS_ORIGINS=https://laoshi.chat
# Go 软内存目标，不是进程 RSS 上限；与 service 的 384M 上限留出余量。
GOMEMLIMIT=256MiB
GOMAXPROCS=2
