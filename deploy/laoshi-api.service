[Unit]
Description=Laoshi modular monolith API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=laoshi
Group=laoshi
WorkingDirectory=/opt/laoshi/current/api
EnvironmentFile=/etc/laoshi/api.env
ExecStart=/opt/laoshi/current/api/laoshi-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LimitNOFILE=8192
MemoryHigh=320M
MemoryMax=384M
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
